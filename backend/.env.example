# Database
DATABASE_URL=sqlite+aiosqlite:///./reelmind.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/reelmind

# AI Provider (optional - uses local engine if not set)
AI_PROVIDER=local
# Options: local, openai, gemini, anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# For Gemini: AI_MODEL=gemini-1.5-flash
# For Anthropic: AI_MODEL=claude-3-haiku-20240307

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App
DEBUG=false
